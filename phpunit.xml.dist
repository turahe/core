<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <php>
        <!-- Database Configuration for Testing -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_USERNAME" value=""/>
        <env name="DB_PASSWORD" value=""/>
        
        <!-- Redis Configuration for Testing -->
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PASSWORD" value=""/>
        <env name="REDIS_PORT" value="6379"/>
        <env name="REDIS_DB" value="1"/>
        
        <!-- Application Configuration -->
        <env name="APP_NAME" value="Turahe Core"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:12345678901234567890123456789012="/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_CIPHER" value="AES-128-CBC"/>
        
        <!-- Core Package Configuration -->
        <env name="CORE_TABLE_USE_TIMESTAMPS" value="false"/>
        
        <!-- User Stamps Configuration -->
        <env name="USERSTAMPS_USERS_TABLE_COLUMN_TYPE" value="ulid"/>
        
        <!-- Cache Configuration -->
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        
        <!-- Logging Configuration -->
        <env name="LOG_CHANNEL" value="stack"/>
        <env name="LOG_DEPRECATIONS_CHANNEL" value="null"/>
        <env name="LOG_LEVEL" value="debug"/>
    </php>

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
