{
    "name": "turahe/core",
    "description": "A comprehensive Laravel package providing core functionality for modern web applications, including image processing, OAuth integration, taxonomy management, organization handling, and utility helpers.",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Wachid",
            "email": "wachid@outlook.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-iconv": "*",
        "ext-intl": "*",
        "google/apiclient": "^2.18",
        "kalnoy/nestedset": "^6.0 || ^7.0",
        "league/fractal": "^0.20.1",
        "league/oauth2-google": "^4.0",
        "microsoft/microsoft-graph": "^1.94",
        "propaganistas/laravel-phone": "^6.1",
        "spatie/eloquent-sortable": "^5.0",
        "spatie/laravel-sluggable": "^4.0",
        "turahe/laravel-userstamps": "^2.0",
        "turahe/master-data": "^2.0",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Turahe\\Core\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Turahe\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Turahe\\Core\\CoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "phpstan": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "rector": "vendor/bin/rector process --dry-run"
    }
}
