# Local ImgProxy settings. Defaults match config/core.php.
# Copy to .env when you want to override them. Docker Compose reads .env automatically.

IMGPROXY_PORT=8080
IMGPROXY_URL=http://127.0.0.1:8080
IMGPROXY_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
IMGPROXY_SALT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
IMGPROXY_SIGNATURE_SIZE=32
